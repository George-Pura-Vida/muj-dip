DirectoryIndex index.php
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://muj-dip.jirijanousek.cz%{REQUEST_URI} [R=301,L,NE]
RewriteRule ^auth(?:/|$) - [F,L]
RewriteRule ^(?:index\.html)?$ index.php [L]
</IfModule>
<FilesMatch "\.(?:sqlite|sqlite3|db|log|env|bak)$">
Require all denied
</FilesMatch>

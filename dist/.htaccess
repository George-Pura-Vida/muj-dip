DirectoryIndex index.php
Options -Indexes
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://muj-dip.jirijanousek.cz%{REQUEST_URI} [R=301,L,NE]
RewriteRule ^auth(?:/|$) - [F,L]
RewriteRule ^$ index.php [L]
</IfModule>
<FilesMatch "\.(?:sqlite|sqlite3|db|log|env|bak)$">
Require all denied
</FilesMatch>

# Template may only be read by authenticated index.php.
<Files "index.html">
Require all denied
</Files>
<IfModule mod_headers.c>
Header always set X-Robots-Tag "noindex, nofollow, noarchive"
Header always set Cache-Control "private, no-store, max-age=0"
</IfModule>
